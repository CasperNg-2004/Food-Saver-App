<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MobileGroup" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Colours -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSecondary">@color/green_button</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Dark status/nav bars -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text & input -->
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorControlNormal">@color/green_dim</item>
        <item name="colorControlActivated">@color/green_primary</item>

        <!-- Dark alert dialog -->
        <item name="materialAlertDialogTheme">@style/Theme.MobileGroup.AlertDialog</item>
    </style>

    <style name="Theme.MobileGroup.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/green_primary</item>
    </style>

</resources>
