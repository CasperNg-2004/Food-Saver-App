<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:elevation="4dp"> <ImageView
    android:id="@+id/imageView_recipe"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:scaleType="centerCrop"
    android:background="#E0E0E0" />

    <TextView
        android:id="@+id/textView_recipe_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipe Name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/textView_missing_ingredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Missing Ingredients: 0"
        android:textSize="14sp"
        android:textColor="#D32F2F" android:layout_marginTop="4dp" />

</LinearLayout>